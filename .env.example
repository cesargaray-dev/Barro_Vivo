# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO - BARRO VIVO
# ==============================================================================
# Instrucciones de configuración segura (Criterios 6 y 7 de la Rúbrica):
#   1. Copia este archivo con el nombre '.env' en la raíz del proyecto:
#      cp .env.example .env
#   2. Reemplaza los valores de ejemplo con las credenciales de tu proyecto Supabase.
#   3. El archivo '.env' real está excluido en .gitignore para evitar su exposición.
#   4. Pasa este archivo al compilar o ejecutar mediante:
#      flutter run --dart-define-from-file=.env
# ==============================================================================

# URL base del proyecto en Supabase (HTTPS)
# Ejemplo ficticio: https://abcdefghijklm.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública del cliente (Anon / Publishable Key).
# Esta clave es pública y segura para apps cliente gracias a las políticas de
# Seguridad a Nivel de Fila (RLS) habilitadas en todas las tablas de PostgreSQL.
# ⚠️ IMPORTANTE: NUNCA coloques aquí la clave administrativa 'service_role'.
SUPABASE_ANON_KEY=tu-anon-key-aqui
